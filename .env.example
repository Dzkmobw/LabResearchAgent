# To separate your traces from other application
LANGSMITH_PROJECT=lab-research-agent
LANGSMITH_TRACING=false

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# DeepSeek V4 is the only LLM provider used by this project.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LAB_AGENT_MODEL=deepseek-v4-flash
LAB_AGENT_THINKING=disabled

# Optional: OpenAlex polite pool contact.
OPENALEX_MAILTO=

# Optional: MCP Web Search.
LAB_AGENT_MCP_SERVERS=
LAB_AGENT_MCP_SEARCH_TOOL=
